DATABASE_URL=sqlite:///./rtmeta.db
DATABASE_ECHO=false

# Service Configuration
POLLING_INTERVAL=1
DEFAULT_MINIMUM_READ_LENGTH=50
ITERATION_INTERVAL_MINUTES=1

# API Configuration
API_TITLE=RT-Metagenomics API
API_VERSION=1.0.0
API_DESCRIPTION=API for RT-Metagenomics analysis

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/app.log

# Databases
DEFAULT_KRAKEN2_DATABASE_DOWNLOAD_URL=https://genome-idx.s3.amazonaws.com/kraken/k2_viral_20251015.tar.gz
KRAKEN2_DATABASE_PATH=./kraken2_database
KRONA_DATABASE_PATH=./krona_database/taxonomy