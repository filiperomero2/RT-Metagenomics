{
  "applicationId": "dev.rtmetagenomics.app",
  "version": "0.1.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "none",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "extensions.*",
    "events.*",
    "window.*"
  ],
  "globalVariables": {},
  "modes": {
    "window": {
      "title": "RT-Metagenomics",
      "icon": "/resources/logo.png",
      "transparency": false,
      "width": 1280,
      "height": 800,
      "minWidth": 800,
      "minHeight": 600,
      "center": true,
      "enableInspector": true,
      "borderless": true,
      "resizable": true
    },
    "browser": {}
  },
  "cli": {
    "binaryName": "rt-metagenomics",
    "resourcesPath": "/resources/",
    "clientLibrary": "/resources/__neutralino_globals.js",
    "binaryVersion": "6.5.0",
    "clientVersion": "6.5.0"
  }
}
