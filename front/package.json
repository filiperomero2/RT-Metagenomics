{
  "name": "rt-metagenomics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "prettier": "prettier src --write",
    "desktop:dev": "concurrently \"vite\" \"neu run -- --url=http://localhost:5173\"",
    "desktop:build": "tsc -b && vite build && cp -r dist/* resources/ && neu build",
    "desktop:start": "tsc -b && vite build && cp -r dist/* resources/ && neu run",
    "desktop:package": "tsc -b && vite build && cp -r dist/* resources/ && neu build --release"
  },
  "dependencies": {
    "@heroui/react": "2.8.2",
    "@heroui/system": "2.4.20",
    "@heroui/theme": "2.4.20",
    "@hookform/resolvers": "^5.2.1",
    "@tanstack/react-query": "^5.84.1",
    "@tanstack/react-router": "^1.120.3",
    "@tanstack/react-store": "^0.7.3",
    "axios": "^1.11.0",
    "chart.js": "^4.5.0",
    "clsx": "^2.1.1",
    "color-interpolate": "^2.0.0",
    "framer-motion": "12.23.12",
    "lucide-react": "^0.510.0",
    "react": "19.1.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "19.1.1",
    "react-hook-form": "^7.62.0",
    "react-resizable-panels": "^3.0.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "4.1.11",
    "usehooks-ts": "^3.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.2.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/router-vite-plugin": "^1.166.6",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
